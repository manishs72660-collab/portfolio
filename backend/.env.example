PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/myportfolio
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=1d
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAIL_USER=your-gmail@gmail.com
MAIL_APP_PASSWORD=your-16-character-google-app-password
MAIL_TO=your-gmail@gmail.com

# RAG: Gemini embeddings/chat model and a dedicated Qdrant collection
GOOGLE_API_KEY=google api key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-2.5-flash
QDRANT_URL=https://your-qdrant-cluster-url
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION_NAME=portfolio_knowledge
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
RAG_MIN_SCORE=0.35
RAG_RATE_LIMIT_WINDOW_MS=900000
RAG_RATE_LIMIT_MAX=15
RAG_CONVERSATION_TTL_DAYS=30